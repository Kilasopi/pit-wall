# Single shared .env for relay + agent (both running outside Docker read
# this directly; Docker Compose also reads it for variable substitution in
# docker-compose.yml). collector/.env stays separate — it's per-machine
# network config (AGENT_HOST), not a secret, and every Sim PC running the
# collector needs its own value there.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# relay
PORT=4000
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# agent
AGENT_PORT=4100
DASHBOARD_PORT=4101

# iRacing account credentials, used only to fetch real track outline SVGs
# from the iRacing Data API for the live track map. If unset, the track map
# card just stays empty. Quote the password if it contains special
# characters like '#'.
IRACING_EMAIL=
IRACING_PASSWORD=
