# Read by `docker compose` for variable substitution in docker-compose.yml
# (relay/agent's DATABASE_URL). Same Neon connection string as relay/.env
# and agent/.env — those are used for running relay/agent outside Docker.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Same values as agent/.env — Compose reads these from the root .env for
# variable substitution, agent/.env's copy only applies when running the
# agent outside Docker. Quote the password if it contains special
# characters like '#'.
IRACING_EMAIL=
IRACING_PASSWORD=
