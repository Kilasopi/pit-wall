# Port this agent's WebSocket server listens on — must match the
# collector's AGENT_PORT.
AGENT_PORT=4100

# Port the dashboard connects to for live stint/fuel/incident broadcasts.
DASHBOARD_PORT=4101

# Same Postgres database relay/ uses (db/schema.sql). If unset, the agent
# still runs and broadcasts to the dashboard, just without persistence.
DATABASE_URL=postgres://postgres:password@localhost:5432/pitwall

# iRacing account credentials, used only to fetch real track outline SVGs
# from the iRacing Data API for the live track map. If unset, the track map
# card just stays empty.
IRACING_EMAIL=
IRACING_PASSWORD=
